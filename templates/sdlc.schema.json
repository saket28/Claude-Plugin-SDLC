{
 "version": 4,
 "roles": [
  "spec-writer",
  "builder",
  "tester",
  "reviewer"
 ],
 "tabs": [
  {
   "id": "global",
   "title": "Global",
   "sections": [
    {
     "id": "pipeline",
     "title": "Pipeline",
     "fields": [
      {
       "path": "global.pipeline.max_rounds",
       "type": "int",
       "min": 1,
       "help": "A round is one pass of build, verify and review: the builder changes the code, then the tests and reviewers respond. After this many rounds without a clean review, a person decides."
      },
      {
       "path": "global.pipeline.critical_thinking",
       "type": "enum",
       "value_type": "int",
       "options": [
        0,
        1,
        2,
        3,
        4,
        5
       ],
       "option_labels": {
        "0": "Off",
        "1": "Flag",
        "2": "Check",
        "3": "Challenge",
        "4": "Sceptical",
        "5": "Adversarial"
       },
       "help": "Default for every agent: how hard it questions its instructions before acting. Each stage can set its own. Higher levels cost more tokens and rounds."
      },
      {
       "path": "global.pipeline.judge_model",
       "type": "enum",
       "options": [
        "haiku",
        "sonnet",
        "opus"
       ],
       "help": "Cheap model for judging reviewer conditions and writing retro learnings"
      },
      {
       "path": "global.pipeline.agent_attempts",
       "type": "int",
       "min": 1,
       "help": "How many times an agent is run for the same step when it doesn't write its report, before the job fails"
      }
     ]
    },
    {
     "id": "learning",
     "title": "Learning",
     "fields": [
      {
       "path": "global.learning.mode",
       "type": "enum",
       "options": [
        "auto",
        "off"
       ],
       "help": "auto: the retro writes new learnings and answers straight into the file; off disables the retro"
      },
      {
       "path": "global.learning.on",
       "type": "list",
       "item_options": [
        "done",
        "failed"
       ],
       "help": "Job outcomes that trigger the retro, one per line"
      }
     ]
    },
    {
     "id": "repo",
     "title": "Repository",
     "fields": [
      {
       "path": "global.repo.base_branch",
       "type": "string",
       "help": "Branch jobs start from and merge into"
      },
      {
       "path": "global.repo.branch_prefix",
       "type": "string",
       "help": "Prefix for job branches, e.g. sdlc/ gives sdlc/job-12"
      },
      {
       "path": "global.repo.branch_name",
       "type": "string",
       "placeholders": [
        "prefix",
        "id",
        "slug"
       ],
       "help": "Job branch name. Placeholders: {prefix}, {id}, {slug} (the title as a short slug)"
      },
      {
       "path": "global.repo.work_dir",
       "type": "string",
       "help": "Local state folder (always gitignored)"
      },
      {
       "path": "global.repo.worktree_dir",
       "type": "string",
       "help": "Where job checkouts go; default is a sibling folder of the repo"
      }
     ]
    },
    {
     "id": "command",
     "title": "Commands",
     "fields": [
      {
       "path": "global.command.setup",
       "type": "string",
       "help": "Run once when a job's worktree is created, e.g. npm ci"
      },
      {
       "path": "global.command.build",
       "type": "string",
       "help": "Build command run by verify"
      },
      {
       "path": "global.command.lint",
       "type": "string",
       "help": "Lint command run by verify"
      },
      {
       "path": "global.command.test",
       "type": "string",
       "help": "Test command run by verify and by the tester"
      },
      {
       "path": "global.command.timeout",
       "type": "int",
       "min": 1,
       "help": "Seconds a command may run before it is stopped"
      }
     ]
    },
    {
     "id": "board",
     "title": "Board",
     "fields": [
      {
       "path": "global.board.adapter",
       "type": "enum",
       "options": [
        "files"
       ],
       "allow_custom": true,
       "help": "Where jobs live: local files, or a repo command adapter path"
      }
     ]
    },
    {
     "id": "budget",
     "title": "Budget (tokens)",
     "fields": [
      {
       "path": "global.budget.per_job",
       "type": "int",
       "min": 0,
       "usage": "job",
       "help": "Most tokens one job may use"
      },
      {
       "path": "global.budget.per_month",
       "type": "int",
       "min": 0,
       "usage": "month",
       "help": "Most tokens all jobs may use this month"
      },
      {
       "path": "global.budget.orchestrate",
       "type": "int",
       "min": 0,
       "help": "Cap for the orchestrating session itself"
      },
      {
       "path": "global.budget.on_exceed",
       "type": "enum",
       "options": [
        "escalate",
        "warn"
       ],
       "help": "What happens when a budget is reached"
      },
      {
       "path": "global.budget.warn_at",
       "type": "float",
       "min": 0,
       "max": 1,
       "help": "Fraction of a budget that triggers a warning"
      }
     ]
    },
    {
     "id": "dashboard",
     "title": "Dashboard",
     "fields": [
      {
       "path": "global.dashboard.stall_after",
       "type": "int",
       "min": 1,
       "help": "Minutes without activity before a running job is marked as possibly stalled"
      }
     ]
    },
    {
     "id": "wait",
     "title": "Waiting",
     "fields": [
      {
       "path": "global.wait.interval",
       "type": "int",
       "min": 1,
       "help": "Seconds between checks while waiting for CI or an approval"
      },
      {
       "path": "global.wait.max_hours",
       "type": "float",
       "min": 0,
       "help": "Hours to wait for CI or an approval before giving up"
      }
     ]
    },
    {
     "id": "guardrail",
     "title": "Guardrails",
     "fields": [
      {
       "path": "global.guardrail.protected_paths",
       "type": "list",
       "additive": true,
       "help": "Extra paths agents may never change (added to the built-in list)"
      },
      {
       "path": "global.guardrail.blocked_commands",
       "type": "list",
       "additive": true,
       "help": "Extra shell commands agents may not run (added to the built-in list)"
      }
     ]
    },
    {
     "id": "principle",
     "title": "Principles",
     "collection": "principles"
    }
   ]
  },
  {
   "id": "spec",
   "title": "Spec",
   "sections": [
    {
     "id": "agent",
     "title": "Spec-writer",
     "fields": [
      {
       "path": "spec.agent.model",
       "type": "enum",
       "options": [
        "opus",
        "sonnet",
        "haiku",
        "fable",
        "inherit"
       ],
       "help": "Model the spec-writer runs on"
      },
      {
       "path": "spec.agent.critical_thinking",
       "type": "enum",
       "value_type": "int",
       "options": [
        0,
        1,
        2,
        3,
        4,
        5
       ],
       "option_labels": {
        "0": "Off",
        "1": "Flag",
        "2": "Check",
        "3": "Challenge",
        "4": "Sceptical",
        "5": "Adversarial"
       },
       "inherits": "global.pipeline.critical_thinking",
       "help": "How hard the spec-writer questions its instructions. Empty uses the global level."
      }
     ]
    },
    {
     "id": "gate",
     "title": "Approval",
     "fields": [
      {
       "path": "spec.gate.mode",
       "type": "enum",
       "options": [
        "none",
        "human"
       ],
       "help": "none: the build starts as soon as the spec is ready. human: a person approves the spec first"
      }
     ]
    },
    {
     "id": "format",
     "title": "Format",
     "fields": [
      {
       "path": "spec.format.sections",
       "type": "list",
       "help": "Extra sections every spec must contain, one per line (e.g. Rollout plan)"
      }
     ]
    },
    {
     "id": "budget",
     "title": "Budget (tokens)",
     "fields": [
      {
       "path": "spec.budget.tokens",
       "type": "int",
       "min": 0,
       "help": "Cap for the spec stage"
      }
     ]
    }
   ]
  },
  {
   "id": "implement",
   "title": "Implement",
   "sections": [
    {
     "id": "agent",
     "title": "Builder",
     "fields": [
      {
       "path": "implement.agent.model",
       "type": "enum",
       "options": [
        "opus",
        "sonnet",
        "haiku",
        "fable",
        "inherit"
       ],
       "help": "Model the builder runs on"
      },
      {
       "path": "implement.agent.critical_thinking",
       "type": "enum",
       "value_type": "int",
       "options": [
        0,
        1,
        2,
        3,
        4,
        5
       ],
       "option_labels": {
        "0": "Off",
        "1": "Flag",
        "2": "Check",
        "3": "Challenge",
        "4": "Sceptical",
        "5": "Adversarial"
       },
       "inherits": "global.pipeline.critical_thinking",
       "help": "How hard the builder questions its instructions. Empty uses the global level."
      }
     ]
    },
    {
     "id": "budget",
     "title": "Budget (tokens)",
     "fields": [
      {
       "path": "implement.budget.tokens",
       "type": "int",
       "min": 0,
       "help": "Cap for building, across rounds"
      }
     ]
    }
   ]
  },
  {
   "id": "test",
   "title": "Test",
   "sections": [
    {
     "id": "agent",
     "title": "Tester",
     "fields": [
      {
       "path": "test.agent.model",
       "type": "enum",
       "options": [
        "opus",
        "sonnet",
        "haiku",
        "fable",
        "inherit"
       ],
       "help": "Model the tester runs on"
      },
      {
       "path": "test.agent.critical_thinking",
       "type": "enum",
       "value_type": "int",
       "options": [
        0,
        1,
        2,
        3,
        4,
        5
       ],
       "option_labels": {
        "0": "Off",
        "1": "Flag",
        "2": "Check",
        "3": "Challenge",
        "4": "Sceptical",
        "5": "Adversarial"
       },
       "inherits": "global.pipeline.critical_thinking",
       "help": "How hard the tester questions its instructions. Empty uses the global level."
      }
     ]
    },
    {
     "id": "scope",
     "title": "Scope",
     "fields": [
      {
       "path": "test.scope.paths",
       "type": "list",
       "help": "Globs the tester may write to"
      }
     ]
    },
    {
     "id": "verify",
     "title": "Verify",
     "fields": [
      {
       "path": "test.verify.order",
       "type": "list",
       "item_options": [
        "lint",
        "build",
        "test"
       ],
       "help": "Commands to run, in this order, one per line. Leave one out to skip it"
      },
      {
       "path": "test.verify.stop_on_failure",
       "type": "bool",
       "help": "Stop at the first failing command instead of running the rest"
      }
     ]
    },
    {
     "id": "budget",
     "title": "Budget (tokens)",
     "fields": [
      {
       "path": "test.budget.tokens",
       "type": "int",
       "min": 0,
       "help": "Cap for verify and the tester"
      }
     ]
    }
   ]
  },
  {
   "id": "review",
   "title": "Review",
   "sections": [
    {
     "id": "agent",
     "title": "Reviewers",
     "fields": [
      {
       "path": "review.agent.model",
       "type": "enum",
       "options": [
        "opus",
        "sonnet",
        "haiku",
        "fable",
        "inherit"
       ],
       "help": "Model the reviewers runs on"
      },
      {
       "path": "review.agent.critical_thinking",
       "type": "enum",
       "value_type": "int",
       "options": [
        0,
        1,
        2,
        3,
        4,
        5
       ],
       "option_labels": {
        "0": "Off",
        "1": "Flag",
        "2": "Check",
        "3": "Challenge",
        "4": "Sceptical",
        "5": "Adversarial"
       },
       "inherits": "global.pipeline.critical_thinking",
       "help": "How hard the reviewers questions its instructions. Empty uses the global level."
      }
     ]
    },
    {
     "id": "severity",
     "title": "Severity",
     "fields": [
      {
       "path": "review.severity.nits_block",
       "type": "bool",
       "help": "Findings marked Nit also send the job back to the builder (normally only Important ones do)"
      }
     ]
    },
    {
     "id": "budget",
     "title": "Budget (tokens)",
     "fields": [
      {
       "path": "review.budget.tokens",
       "type": "int",
       "min": 0,
       "help": "Cap for reviews"
      }
     ]
    },
    {
     "id": "reviewer",
     "title": "Reviewers",
     "collection": "reviewers"
    }
   ]
  },
  {
   "id": "release",
   "title": "Release",
   "sections": [
    {
     "id": "gate",
     "title": "Approval",
     "fields": [
      {
       "path": "release.gate.mode",
       "type": "enum",
       "options": [
        "none",
        "human"
       ],
       "help": "none: merge as soon as everything passes. human: a person approves the merge (with GitHub, the PR's approval)"
      }
     ]
    },
    {
     "id": "merge",
     "title": "Merge",
     "fields": [
      {
       "path": "release.merge.strategy",
       "type": "enum",
       "options": [
        "squash",
        "merge",
        "rebase"
       ],
       "help": "How a finished job lands on the base branch: squash = one commit, merge = merge commit, rebase = keep every commit. The branch is always rebased onto base and re-verified first"
      },
      {
       "path": "release.merge.message",
       "type": "string",
       "placeholders": [
        "title",
        "id",
        "branch"
       ],
       "help": "Commit message for squash and merge commits. Placeholders: {title}, {id}, {branch}"
      },
      {
       "path": "release.merge.delete_branch",
       "type": "bool",
       "help": "Delete the job branch after it is merged"
      }
     ]
    },
    {
     "id": "pr",
     "title": "Pull request",
     "fields": [
      {
       "path": "release.pr.draft",
       "type": "bool",
       "help": "Open pull requests as drafts (GitHub)"
      },
      {
       "path": "release.pr.labels",
       "type": "list",
       "help": "Labels added to the pull request, one per line (they must exist)"
      },
      {
       "path": "release.pr.reviewers",
       "type": "list",
       "help": "Reviewers requested on the pull request, one per line"
      }
     ]
    },
    {
     "id": "ci",
     "title": "CI",
     "fields": [
      {
       "path": "release.ci.required",
       "type": "bool",
       "help": "Wait for CI to pass before merging, and send the job back if it fails"
      }
     ]
    },
    {
     "id": "cleanup",
     "title": "Cleanup",
     "fields": [
      {
       "path": "release.cleanup.worktree",
       "type": "bool",
       "help": "Remove the job's checkout after it is merged"
      }
     ]
    },
    {
     "id": "host",
     "title": "Host",
     "fields": [
      {
       "path": "release.host.adapter",
       "type": "enum",
       "options": [
        "local",
        "github"
       ],
       "allow_custom": true,
       "help": "Where code lands: local git, GitHub (via gh), or a repo command adapter path"
      }
     ]
    },
    {
     "id": "budget",
     "title": "Budget (tokens)",
     "fields": [
      {
       "path": "release.budget.tokens",
       "type": "int",
       "min": 0,
       "help": "Cap for merge-step reviewers"
      }
     ]
    }
   ]
  },
  {
   "id": "learnings",
   "title": "Learnings",
   "learnings": true,
   "sections": []
  }
 ],
 "reviewer_fields": [
  {
   "key": "kind",
   "type": "enum",
   "options": [
    "instructions",
    "agent",
    "run"
   ],
   "help": "Instructions file, project subagent, or shell command"
  },
  {
   "key": "at",
   "type": "enum",
   "options": [
    "spec",
    "review",
    "merge"
   ],
   "help": "Which step it runs at"
  },
  {
   "key": "when",
   "type": "rule",
   "help": "always | never | touches-ui | risk>=low|medium|high | paths:[globs], joined with 'or'"
  },
  {
   "key": "condition",
   "type": "string",
   "help": "Plain-language condition judged per job, e.g. 'changes a public API'"
  },
  {
   "key": "blocking",
   "type": "bool",
   "help": "If off, findings are recorded but never block"
  },
  {
   "key": "model",
   "type": "enum",
   "options": [
    "opus",
    "sonnet",
    "haiku",
    "fable",
    "inherit"
   ],
   "help": "Which model runs this reviewer; empty follows review.agent.model"
  },
  {
   "key": "critical_thinking",
   "type": "enum",
   "value_type": "int",
   "options": [
    0,
    1,
    2,
    3,
    4,
    5
   ],
   "option_labels": {
    "0": "Off",
    "1": "Flag",
    "2": "Check",
    "3": "Challenge",
    "4": "Sceptical",
    "5": "Adversarial"
   },
   "help": "How hard it questions its instructions; empty follows review.agent.critical_thinking"
  },
  {
   "key": "effort",
   "type": "enum",
   "options": [
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
   ],
   "help": "How hard the built-in /code-review looks"
  }
 ]
}
